# ============================================================
# DIS·INSTA — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit the real .env file to GitHub!

# ─── Instagram / Meta App Credentials ───────────────────────
# Get these from: https://developers.facebook.com/apps/
IG_APP_ID=YOUR_INSTAGRAM_APP_ID_HERE
IG_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET_HERE

# ─── OAuth Redirect URI ─────────────────────────────────────
# Must match EXACTLY what you set in Meta Developer Console
# For local dev use: http://localhost:3000/auth/callback
REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Session Secret (generate a random string) ──────────────
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_STRING
